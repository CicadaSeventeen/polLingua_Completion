use serde::{Deserialize, Serialize};
use std::collections::HashMap;

#[derive(Debug, Deserialize, Serialize, PartialEq, Eq, Hash)]
#[serde(rename_all = "snake_case")]
enum ConfigKey {
	Retries,
	Timeout,
	LogLevel,
}

#[derive(Debug, Deserialize, Serialize, PartialEq)]
#[serde(rename_all = "lowercase")]
enum ConfigValue {
	High,
	Low,
	Info,
	Debug,
}
fn main() {
// 现在你可以解析为 HashMap<ConfigKey, ConfigValue>
	let json = r#"{"retries": "high", "timeout": "low"}"#;
	let map: HashMap<ConfigKey, ConfigValue> = serde_json::from_str(json).unwrap();
	map.iter().for_each(|x| {
		match x.0 {
			ConfigKey::Retries => println!("Re"),
			ConfigKey::Timeout => println!("1"),
			_ => todo!(),
		}
	});
}
