use serde::Deserialize;

// 1. 先定义那个被嵌套使用的枚举
#[derive(Debug, Deserialize)]
#[serde(rename_all = "lowercase")] // JSON里的 "info" 对应 Rust里的 Info
enum LogLevel {
    Info,
    Debug,
    Warn,
    Error,
}

// 2. 定义你的结构体
// 这里的字段名直接对应 JSON 的 Key
#[derive(Debug, Deserialize)]
struct AdvancedConfig {
    retries: u32,         // 对应 JSON 中的数字
    log_level: LogLevel,  // 对应 JSON 中的字符串（自动转为枚举）
    enabled: bool,        // 对应 JSON 中的布尔值
}

fn main() {
    // 3. 准备 JSON 数据
    // 注意：JSON 的值的类型必须和结构体字段类型对应
    let json = r#"{
        "retries": 3,
        "log_level": "debug",
        "enabled": true
    }"#;

    // 4. 解析
    // 这里的泛型指明了我们要解析成 AdvancedConfig 结构体
    let config: AdvancedConfig = serde_json::from_str(json).unwrap();

    // 5. 直接使用字段，不仅有自动补全，还有类型检查
    println!("重试次数: {}", config.retries);
    println!("日志级别: {:?}", config.log_level);

    if config.enabled {
        println!("服务已启用");
    }
}
