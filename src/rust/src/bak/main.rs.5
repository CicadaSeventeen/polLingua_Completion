use serde::Deserialize;
use serde::Serialize;
use serde_aux::prelude::*;
use std::collections::HashMap;

#[derive(Debug, Serialize, Deserialize, Clone)]
#[serde(rename_all = "lowercase")]
enum FuncName {
	Root,
	Affix,
	Identity,
}


#[derive(Debug, Serialize, Deserialize, Clone)]
struct TreeNode {
	func: FuncName,
	args: HashMap<String,String>,
	#[serde(deserialize_with = "deserialize_bool_from_anything")]
	ret: bool,
	children: Vec<TreeNode>,
}

fn main() {
    // 关键修改 2: 修正 JSON 语法错误
    let json = r#"{
  "func": "root",
  "args": {},
  "ret": false,
  "children": [
    {
      "func": "affix",
      "args": {
        "prefix": "test_"
      },
      "ret": false,
      "children": [
        {
          "func": "affix",
          "args": {
            "prefix": "new_"
          },
          "ret": true,
          "children": []
        }
      ]
    },
    {
      "func": "affix",
      "args": {
        "prefix": "a_",
        "suffix": "_b"
      },
      "ret": true,
      "children": []
    },
    {
      "func": "identity",
      "args": {},
      "ret": true,
      "children": []
    }
  ]
}
"#;
    // 解析
    let config: TreeNode = serde_json::from_str(json).unwrap();
	println!("{:?}",config);
}
