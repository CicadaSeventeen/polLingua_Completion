use std::borrow::Cow;
/// 检查字符串中是否包含满足 predicates 条件的字符
pub fn contains_category<F>(s: &str, predicate: F) -> bool
where
	F: Fn(char) -> bool,
{
    s.chars().any(predicate)
}

/// 检查字符串是否完全由满足 predicates 条件的字符组成
pub fn is_entirely_category<F>(s: &str, predicate: F) -> bool
where
    F: Fn(char) -> bool,
{
    !s.is_empty() && s.chars().all(predicate)
}

#[derive(Debug, PartialEq, Clone)]
enum TextSlice<'a> {
	Matched(&'a str),
	Unmatched(&'a str),
}

impl<'a> TextSlice<'a> {
	pub fn as_str(&self) -> &'a str {
		match self {
			TextSlice::Matched(s) | TextSlice::Unmatched(s) => s
		}
	}
}

fn split_by_category<'a, F>(s: &'a str, predicate: F) -> Vec<TextSlice<'a>>
where
F: Fn(char) -> bool,
{
	let mut segments = Vec::new();
	let last_idx = 0;
	let mut iter = s.char_indices().peekable();

	while let Some((start_idx, first_char)) = iter.next() {
		let target_state = predicate(first_char);
		let mut end_idx = start_idx + first_char.len_utf8();
		while let Some(&(idx, c)) = iter.peek() {
			if predicate(c) == target_state {
				end_idx = idx + c.len_utf8();
				iter.next();
			} else {
				break;
			}
		}
		let slice = &s[start_idx..end_idx];
		if target_state {
			segments.push(TextSlice::Matched(slice));
		} else {
			segments.push(TextSlice::Unmatched(slice));
		}
	}
	segments
}

#[allow(dead_code)]
fn exec_func_single_on_matched_to_segments<'a, F>(segments: Vec<TextSlice<'a>>, operation: F) -> Vec<TextSlice<'a>>
where
F: Fn(&str) -> Cow<'a, str>,
{
	segments.iter().map(|x|
		match x {
			TextSlice::Matched(s) => TextSlice::Matched(operation(s).as_ref()),
			TextSlice::Unmatched(s) => x.clone(),
		}
	).collect()
}

#[allow(dead_code)]
fn get_split_list<'a>(segments: Vec<TextSlice<'a>>) -> (Vec<&'a str>, Vec<&'a str>) {
	let tmp: (Vec<TextSlice<'a>>, Vec<TextSlice<'a>>) = segments.into_iter().partition(|seg| {
		matches!(seg, TextSlice::Matched(_))
	});
	(tmp.0.iter().map(|x| x.as_str()).collect() , tmp.1.iter().map(|x| x.as_str()).collect())
}

fn join_segments<'a>(segments: Vec<TextSlice<'a>>) -> String
{
	segments.iter().map(|seg| match seg {
		TextSlice::Matched(s) => *s,
		TextSlice::Unmatched(s) => *s,
	}).collect::<String>()
}

#[allow(dead_code)]
pub fn exec_func_on_matched_to_string<'a,F1,F2>( input: &'a str, predicate: F1, operation: F2 ) -> String
where
	F1: Fn(char) -> bool,
	F2: Fn(&str) -> Cow<'a, str>,
{
	join_segments(exec_func_single_on_matched_to_segments(split_by_category(input, predicate),operation))
}

use itertools::Itertools;
use std::collections::HashSet;
pub  fn exec_func_on_matched<F1,F2>( input: &str, predicate: F1, operation: F2 ) -> HashSet<String>
where
F1: Fn(char) -> bool,
F2: Fn(&str) -> Vec<String>,
{
	let choices:Vec<Vec<String>> = split_by_category(input, predicate).iter().map(|seg| match seg {
		TextSlice::Matched(s) => operation(*s),
		TextSlice::Unmatched(s) => vec![(*s).to_string()],
	}).collect();
	let results: HashSet<String> = choices
	.into_iter()
	.multi_cartesian_product() // 核心逻辑：生成所有可能的组合
	.map(|combination| combination.join("")) // 将每种组合连成字符串
	.collect();
	return results;
}

